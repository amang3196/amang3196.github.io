---
import Base from "../layouts/Base.astro";
import { NAME } from "../data/site";
---
<Base title={`Page not found | ${NAME}`}>
  <section class="not-found">
    <h1 class="gradient-text">404</h1>
    <p class="muted">This page doesn't exist.</p>
    <a class="btn btn-primary" href={import.meta.env.BASE_URL}>Back to home</a>
  </section>
</Base>
