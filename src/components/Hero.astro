---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { NAME, FIRST_NAME, HEADLINE, DESCRIPTION, RESUME_FILE, PROFILE_PIC, SOCIAL_MEDIA, STATS } from "../data/site";

const resumeUrl = `${import.meta.env.BASE_URL}${RESUME_FILE}`;
---
<section class="hero" id="about">
  <div class="bento hero-grid">
    <div class="tile tile-intro">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>Hi, I am {FIRST_NAME} 👋</p>
      <h1 class="gradient-text">{HEADLINE}</h1>
      <p class="lead">{DESCRIPTION}</p>
      <div class="actions">
        <a class="btn btn-primary" href={resumeUrl} download>
          <Icon name="download" /> Download Resume
        </a>
        {SOCIAL_MEDIA.map((s) => (
          <a
            class="btn btn-ghost"
            href={s.url}
            {...(s.url.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            <Icon name={s.icon} /> {s.name}
          </a>
        ))}
      </div>
    </div>

    <div class="tile tile-photo">
      <Image
        src={PROFILE_PIC}
        alt={`Photo of ${NAME}`}
        widths={[200, 300, 400, 612]}
        sizes="(max-width: 820px) 200px, 300px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <ul class="bento stats" aria-label="Highlights">
    {STATS.map((s) => (
      <li class="tile stat">
        <span class="stat-value gradient-text">{s.value}</span>
        <span class="stat-label">{s.label}</span>
      </li>
    ))}
  </ul>
</section>
