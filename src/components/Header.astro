---
import Icon from "./Icon.astro";
import { NAME } from "../data/site";

const base = import.meta.env.BASE_URL;
const links = [
  { id: "about", label: "About" },
  { id: "achievements", label: "Achievements" },
  { id: "experience", label: "Experience" },
  { id: "education", label: "Education" },
  { id: "contact", label: "Contact" },
];
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={base}>{NAME}</a>

    <nav class="nav" id="site-nav" aria-label="Main">
      {links.map((l) => <a href={`${base}#${l.id}`} data-nav={l.id}>{l.label}</a>)}
    </nav>

    <div class="header-actions">
      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <Icon name="menu" class="when-closed" />
        <Icon name="close" class="when-open" />
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const menuBtn = header.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;

  // ---- Mobile menu --------------------------------------------------------
  const setMenu = (open: boolean) => {
    header.toggleAttribute("data-open", open);
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };
  menuBtn.addEventListener("click", () => setMenu(!header.hasAttribute("data-open")));
  header.querySelectorAll(".nav a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") setMenu(false); });
  document.addEventListener("click", (e) => {
    if (!header.contains(e.target as Node)) setMenu(false);
  });
  // Close the menu if the screen is resized to the desktop layout.
  window.matchMedia("(min-width: 821px)").addEventListener?.("change", (e) => { if (e.matches) setMenu(false); });

  // ---- Highlight the nav link for the section in view ---------------------
  const navLinks = header.querySelectorAll<HTMLAnchorElement>("[data-nav]");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinks.forEach((a) => a.classList.toggle("active", a.dataset.nav === entry.target.id));
        });
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    document.querySelectorAll("main section[id]").forEach((s) => observer.observe(s));
  }
</script>
